# ================= AI 智能配音（LLM）=================
# OpenAI 兼容接口地址（如 https://api.openai.com/v1 / https://open.bigmodel.cn/api/paas/v4）
OPENAI_BASE_URL=https://api.openai.com/v1
# API Key
OPENAI_API_KEY=sk-xxxxxxxxxxx
# 模型名称（如 gpt-4o-mini / glm-5.3-flash / deepseek-chat）
MODEL_NAME=glm-5.3-flash

# ================= 声音克隆（XTTS，可选）=================
# 克隆服务地址。不设置时 Docker 部署默认指向 compose 内的 xtts-server（需 --profile clone 启用）
# 独立部署示例：TTS_CLONE_URL=http://192.168.1.10:8020
#TTS_CLONE_URL=
# 克隆服务容器内参考音频目录（随部署方式调整）
#TTS_CLONE_SPEAKERS_DIR=/app/speakers/custom-voices

# ================= Docker Compose =================
# 设为 clone 后，`docker compose up -d` 默认带上 xtts-server（不必每次加 --profile clone）
#COMPOSE_PROFILES=clone

# ================= 其他（可选）=================
# 接口限速：时间窗口（秒）与窗口内最大请求数
#RATE_LIMIT_WINDOW=10
#RATE_LIMIT=1000000
