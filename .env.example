# ================= AI 智能配音（LLM）=================
# OpenAI 兼容接口地址（如 https://api.openai.com/v1 / https://open.bigmodel.cn/api/paas/v4）
OPENAI_BASE_URL=https://api.openai.com/v1
# API Key
OPENAI_API_KEY=sk-xxxxxxxxxxx
# 模型名称（如 gpt-4o-mini / glm-5.3-flash / deepseek-chat）
MODEL_NAME=glm-5.3-flash

# ================= 声音克隆（XTTS，可选加项）=================
# 直接用参考声音合成，CPU 较慢。默认一键部署不含它，需要时在 compose 加 --profile clone
#TTS_CLONE_URL=
#TTS_CLONE_SPEAKERS_DIR=/app/speakers/custom-voices

# ================= 音色转换（OpenVoice / RVC）=================
# 不设置时 Docker 部署默认指向 compose 内的 vc-server / rvc-server
# 独立部署示例：VC_SERVER_URL=http://192.168.1.10:9090 / RVC_SERVER_URL=http://192.168.1.10:9091
#VC_SERVER_URL=
#RVC_SERVER_URL=

# ================= 声音克隆合成（OmniVoice，可选）=================
# 新一代零样本克隆 TTS：文本+参考音频一步合成，质量高；CPU 较慢，推荐 GPU 机器启用。
# 需要 --profile omnivoice 部署 omnivoice-server；不设置时默认指向 compose 内的 omnivoice-server
# 独立部署示例：OMNIVOICE_SERVER_URL=http://192.168.1.10:9092
#OMNIVOICE_SERVER_URL=
# GPU 加速（NVIDIA 显卡机器）：设 cu126 构建 CUDA 版 torch（默认 cpu），
# 并配合 docker-compose.gpu.yml 启动（详见 README「GPU 加速」）
#TORCH_BUILD=cu126
# 扩散解码步数：CPU 建议 16，GPU 建议 32（质量更优）
#OMNIVOICE_NUM_STEP=16

# ================= Docker Compose =================
# 一键部署（主服务 + OpenVoice 换声 + RVC 换声）：`docker compose up -d --build`
#   vc=OpenVoice 换声  rvc=RVC 换声  clone=XTTS 声音克隆  omnivoice=OmniVoice 克隆（可选加项）
COMPOSE_PROFILES=vc,rvc

# ================= 其他（可选）=================
# 接口限速：时间窗口（秒）与窗口内最大请求数
#RATE_LIMIT_WINDOW=10
#RATE_LIMIT=1000000
